FROM python:3.11-slim

WORKDIR /code

# libpango/libharfbuzz/fontconfig are required by WeasyPrint (song PDF export) to render text
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app /code/app

ENV UPLOAD_DIR=./data/uploads

VOLUME /code/data/uploads

EXPOSE 8080

# CleverCloud injects PORT=8080; fall back to 8000 for local use
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
